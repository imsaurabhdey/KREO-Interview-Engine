# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: High-speed backup inference engine for automatic rate-limit and timeout failsafe.
# Generates near-instant responses using Llama 3.3 70B & Llama 3.1 8B when Gemini hits quotas.
# Obtain your free API key at https://console.groq.com/keys
GROQ_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BREVO_API_KEY: Transactional email dispatch service (300 emails/day free).
# Sign up at brevo.com to generate your API key under SMTP & API -> API Keys.
# If empty, emails run safely in simulated sandbox mode logging output to the terminal.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="IRIS AI Assessment Engine"

# CLOUDFLARE R2 BUCKET INTEGRATION (Optional)
# If configured, secure interview recordings will be uploaded directly to Cloudflare R2.
# Otherwise, the system defaults to secure local storage under the recordings/ directory.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=
